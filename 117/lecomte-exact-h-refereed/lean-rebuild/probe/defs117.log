def Erdos117.NoncommutingBound.{u_2} : (G : Type u_2) → [Group G] → ℕ → Prop :=
fun G [Group G] n => ∀ (s : Finset G), ((↑s).Pairwise fun x y => ¬Commute x y) → s.card ≤ n
