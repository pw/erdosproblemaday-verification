def OAI.EuclideanFiveColor.ProperColoring : (colorCount : Nat) → (coloring : Complex → Fin colorCount) → Prop :=
fun (colorCount : Nat) (coloring : Complex → Fin colorCount) =>
  ∀ (point otherPoint : Complex),
    @Eq.{1} Real
        (@Norm.norm.{0} Complex Complex.instNorm
          (@HSub.hSub.{0, 0, 0} Complex Complex Complex (@instHSub.{0} Complex Complex.instSub) point otherPoint))
        (@OfNat.ofNat.{0} Real (nat_lit 1) (@One.toOfNat1.{0} Real Real.instOne)) →
      @Ne.{1} (Fin colorCount) (coloring point) (coloring otherPoint)
