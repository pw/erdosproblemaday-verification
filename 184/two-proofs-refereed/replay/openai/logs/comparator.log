def OAI.ErdosGallai.CycleOrSingleEdge : {V : Type} → (G : SimpleGraph.{0} V) → (s : Set.{0} (Sym2.{0} V)) → Prop :=
fun {V : Type} (G : SimpleGraph.{0} V) (s : Set.{0} (Sym2.{0} V)) =>
