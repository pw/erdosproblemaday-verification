        (@Pairwise.{0} (Fin k) fun (i j : Fin k) =>
          @Disjoint.{0} (Set.{0} (Sym2.{0} V))
            (@CompletePartialOrder.toPartialOrder.{0} (Set.{0} (Sym2.{0} V))
