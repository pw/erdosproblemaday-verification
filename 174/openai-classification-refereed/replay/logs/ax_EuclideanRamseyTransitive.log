def OAI.EuclideanRamsey.Ramsey : {s d : Nat} → (a : Fin s → OAI.EuclideanRamsey.Space d) → Prop :=
fun {s d : Nat} (a : Fin s → OAI.EuclideanRamsey.Space d) =>
  ∀ (r : Nat),
