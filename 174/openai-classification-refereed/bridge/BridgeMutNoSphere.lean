import OAI.Combinatorics.EuclideanRamsey.Quadratic
import OAI.Combinatorics.EuclideanRamsey.Spherical

/-!
# Erdős #174 bridge (ours, 21 Oct 2026): spherical + algebraic coordinates ⇒ Ramsey

Consequence of OpenAI's `OAI.EuclideanRamsey.classification` (Theorem 1.1 of "A classification of
finite Euclidean Ramsey configurations", 23 Sep 2026) that the paper does not state: when every
coordinate is an algebraic number, the coordinate field `F` is a number field, `F ⊗[ℚ] F` is
formally unramified over `F`, so the kernel of multiplication is generated by an idempotent `e`;
`1 - e` lifts the ordinary sphere matrix to a solution of the field criterion.
-/

namespace Bridge174

open OAI OAI.EuclideanRamsey
open scoped TensorProduct

noncomputable section

theorem coeff_finiteDimensional {s d : ℕ} (a : Fin s → Space d)
    (halg : ∀ i j, IsAlgebraic ℚ (a i j)) : FiniteDimensional ℚ (Coeff a) := by
  have hfin : (Set.range (fun ij : Fin s × Fin d => a ij.1 ij.2)).Finite := Set.finite_range _
  have := hfin.to_subtype
  exact IntermediateField.finiteDimensional_adjoin (fun x hx => by
    obtain ⟨ij, rfl⟩ := hx
    exact (halg ij.1 ij.2).isIntegral)

theorem algebraic_spherical_fieldCriterion {s d : ℕ} (a : Fin s → Space d)
    (halg : ∀ i j, IsAlgebraic ℚ (a i j))
    (hsphere : True) :
    FieldCriterion a := by
  classical
  have := coeff_finiteDimensional a halg
  have : Algebra.FormallyUnramified ℚ (Coeff a) :=
    Algebra.FormallyUnramified.of_isSeparable ℚ (Coeff a)
  obtain ⟨e, he, hspan⟩ : ∃ e, IsIdempotentElem e ∧
      KaehlerDifferential.ideal ℚ (Coeff a) = Ideal.span {e} :=
    (Ideal.isIdempotentElem_iff_of_fg _ (KaehlerDifferential.ideal_fg ℚ (Coeff a))).mp <|
      (Ideal.cotangent_subsingleton_iff _).mp <| inferInstanceAs <| Subsingleton Ω[Coeff a⁄ℚ]
  obtain ⟨h, hrows, hdiag⟩ := OAI.EuclideanRamsey.sphere_field_quadratic a hsphere
  have he_mem : e ∈ KaehlerDifferential.ideal ℚ (Coeff a) := by
    rw [hspan]; exact Ideal.subset_span rfl
  have hme : multiply a e = 0 := RingHom.mem_ker.mp he_mem
  have hfm : multiply a (1 - e) = 1 := by rw [map_sub, hme, sub_zero]; exact (multiply a).toRingHom.map_one
  have hkill : ∀ x ∈ KaehlerDifferential.ideal ℚ (Coeff a), (1 - e) * x = 0 := by
    intro x hx
    rw [hspan, Ideal.mem_span_singleton'] at hx
    obtain ⟨c, rfl⟩ := hx
    rw [mul_comm, mul_assoc, mul_sub, mul_one, he.eq, sub_self, mul_zero]
  refine ⟨fun α β => (1 - e) * (h (α, β) ⊗ₜ[ℚ] (1 : Coeff a)), ?_, ?_⟩
  · intro i
    let X : TensorRing a := ∑ α, ∑ β,
      ((augmented a i α) ⊗ₜ[ℚ] (1 : Coeff a)) * (h (α, β) ⊗ₜ[ℚ] (1 : Coeff a)) *
        ((1 : Coeff a) ⊗ₜ[ℚ] (augmented a i β))
    have hX : X ∈ KaehlerDifferential.ideal ℚ (Coeff a) := by
      apply RingHom.mem_ker.mpr
      have hr := congrFun hrows i
      simp only [Matrix.mulVec, dotProduct, OAI.EuclideanRamsey.augmentedQuadraticRows,
        Fintype.sum_prod_type, Pi.zero_apply] at hr
      show multiply a X = 0
      simp only [X, map_sum, map_mul, multiply, Algebra.TensorProduct.lmul'_apply_tmul,
        mul_one, one_mul]
      rw [← hr]
      refine Finset.sum_congr rfl (fun α _ => Finset.sum_congr rfl (fun β _ => ?_))
      ring
    have := hkill X hX
    rw [← this, Finset.mul_sum]
    refine Finset.sum_congr rfl (fun α _ => ?_)
    rw [Finset.mul_sum]
    refine Finset.sum_congr rfl (fun β _ => ?_)
    ring
  · intro α β
    show multiply a ((1 - e) * (h (some α, some β) ⊗ₜ[ℚ] (1 : Coeff a))) = _
    rw [show multiply a ((1 - e) * (h (some α, some β) ⊗ₜ[ℚ] (1 : Coeff a))) =
        multiply a (1 - e) * multiply a (h (some α, some β) ⊗ₜ[ℚ] (1 : Coeff a)) from
      (multiply a).toRingHom.map_mul _ _, hfm, one_mul]
    simp only [multiply, Algebra.TensorProduct.lmul'_apply_tmul, mul_one]
    exact hdiag α β

/-- Every spherical configuration of at least two points with full affine span whose coordinates
are all algebraic numbers is Euclidean Ramsey (via OpenAI's classification). -/
theorem algebraic_spherical_ramsey {s d : ℕ} (a : Fin s → Space d)
    (hs : 2 ≤ s) (hd : 1 ≤ d) (ha : Function.Injective a)
    (hspan : affineSpan ℝ (Set.range a) = ⊤)
    (hsphere : ∃ c : Space d, ∃ r : ℝ, ∀ i, dist (a i) c = r)
    (halg : ∀ i j, IsAlgebraic ℚ (a i j)) : Ramsey a :=
  (classification a hs hd ha hspan).mpr (algebraic_spherical_fieldCriterion a halg hsphere)

/-- For algebraic configurations, Graham's spherical conjecture holds: Ramsey ⇔ cospherical. -/
theorem algebraic_ramsey_iff_cospherical {s d : ℕ} (a : Fin s → Space d)
    (hs : 2 ≤ s) (hd : 1 ≤ d) (ha : Function.Injective a)
    (hspan : affineSpan ℝ (Set.range a) = ⊤)
    (halg : ∀ i j, IsAlgebraic ℚ (a i j)) :
    Ramsey a ↔ EuclideanGeometry.Cospherical (Set.range a) := by
  constructor
  · exact ramsey_cospherical a ha
  · rintro ⟨c, r, hcr⟩
    exact algebraic_spherical_ramsey a hs hd ha hspan
      ⟨c, r, fun i => hcr (a i) (Set.mem_range_self i)⟩ halg

end

end Bridge174
