Powerfree (def body) MATCH
   FC  : def Powerfree [Monoid M] (k : ℕ) (m : M) : Prop := ∀ ⦃x : M⦄, x ^ k ∣ m → IsUnit x
   ours: def Powerfree [Monoid M] (k : ℕ) (m : M) : Prop := ∀ ⦃x : M⦄, x ^ k ∣ m → IsUnit x
partialDensity MATCH
   FC  : noncomputable abbrev partialDensity {β : Type*} [Preorder β] [LocallyFiniteOrderBot β] (S : Set β) (A : Set β := Set.univ) (b : β) : ℝ := ((S ∩ A) ∩ Iio b).ncard / (A ∩ Iio b).ncard
   ours: noncomputable abbrev partialDensity {β : Type*} [Preorder β] [LocallyFiniteOrderBot β] (S : Set β) (A : Set β := Set.univ) (b : β) : ℝ := ((S ∩ A) ∩ Iio b).ncard / (A ∩ Iio b).ncard
HasDensity MATCH
   FC  : def HasDensity {β : Type*} [Preorder β] [LocallyFiniteOrderBot β] (S : Set β) (α : ℝ) (A : Set β := Set.univ) : Prop := Tendsto (fun (b : β) => S.partialDensity A b) atTop (𝓝 α)
   ours: def HasDensity {β : Type*} [Preorder β] [LocallyFiniteOrderBot β] (S : Set β) (α : ℝ) (A : Set β := Set.univ) : Prop := Tendsto (fun (b : β) => S.partialDensity A b) atTop (𝓝 α)
HasPosDensity MATCH
   FC  : def HasPosDensity {β : Type*} [Preorder β] [LocallyFiniteOrderBot β] (S : Set β) (A : Set β := Set.univ) : Prop := ∃ α > 0, S.HasDensity α A
   ours: def HasPosDensity {β : Type*} [Preorder β] [LocallyFiniteOrderBot β] (S : Set β) (A : Set β := Set.univ) : Prop := ∃ α > 0, S.HasDensity α A
