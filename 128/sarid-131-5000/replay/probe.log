def Erdos128.ModuloBCL.BCLEventual : Prop :=
∃ N,
  ∀ (W : Type) [inst : Fintype W] [inst_1 : DecidableEq W] (H : SimpleGraph W) [inst_2 : DecidableRel H.Adj],
    N ≤ Fintype.card W → H.CliqueFree 3 → Erdos128.BCLCutCertificate H
def Erdos128.BCLCutCertificate.{u} : {V : Type u} →
  [Fintype V] → [DecidableEq V] → (G : SimpleGraph V) → [DecidableRel G.Adj] → Prop :=
fun {V} [Fintype V] [DecidableEq V] G [DecidableRel G.Adj] =>
  ∃ X, ↑(Erdos128.edgeCountOn G X + Erdos128.edgeCountOn G Xᶜ) ≤ 2 / 47 * ↑(Fintype.card V) ^ 2
def Erdos128.HasSparseHalf.{u} : {V : Type u} →
  [Fintype V] → [DecidableEq V] → (G : SimpleGraph V) → [DecidableRel G.Adj] → ℚ → Prop :=
fun {V} [Fintype V] [DecidableEq V] G [DecidableRel G.Adj] B =>
  ∃ S, S.card = Fintype.card V / 2 ∧ ↑(Erdos128.edgeCountOn G S) ≤ B
def Erdos128.edgeCountOn.{u} : {V : Type u} →
  [Fintype V] → [DecidableEq V] → (G : SimpleGraph V) → [DecidableRel G.Adj] → Finset V → ℕ :=
fun {V} [Fintype V] [DecidableEq V] G [DecidableRel G.Adj] S => (G.edgeFinset ∩ S.sym2).card
def Erdos128.FormalConjecturesStatement : ℕ → ℕ → Prop :=
fun numerator denominator =>
  ∀ (V : Type) [inst : Fintype V] (G : SimpleGraph V),
    (∀ (V' : Set V),
        2 * V'.ncard + 1 ≥ Fintype.card V →
          denominator * (SimpleGraph.induce V' G).edgeSet.ncard > numerator * Fintype.card V ^ 2) →
      ¬G.CliqueFree 3
def Erdos128.C4FlagCertificate.{u} : {V : Type u} →
  [Fintype V] → [DecidableEq V] → (G : SimpleGraph V) → [DecidableRel G.Adj] → Prop :=
fun {V} [Fintype V] [DecidableEq V] G [DecidableRel G.Adj] =>
  have n := ↑(Fintype.card V);
  have m := ↑G.edgeFinset.card;
  n ^ 2 * Erdos128.c4Hom G ≥ 8 * m ^ 3 - 2 * Erdos128.c4FlagGamma * m * n ^ 4
def Erdos128.c4Hom.{u} : {V : Type u} →
  [Fintype V] → [DecidableEq V] → (G : SimpleGraph V) → [DecidableRel G.Adj] → ℚ :=
fun {V} [Fintype V] [DecidableEq V] G [DecidableRel G.Adj] => (SimpleGraph.adjMatrix ℚ G ^ 4).trace
