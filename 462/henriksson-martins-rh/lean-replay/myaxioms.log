Erdos462RH.theorem_1_1 : (∀ (Y d : ℝ),
    (10 : ℝ) ^ (13 : ℕ) ≤ Y →
      (0 : ℝ) < d →
        d ≤ (1 : ℝ) / (10 : ℝ) ^ (13 : ℕ) →
          ∫ (v : ℝ) in (1 : ℝ)..Y, (Chebyshev.theta (((1 : ℝ) + d) * v) - Chebyshev.theta v - d * v) ^ (2 : ℕ) ≤
            (25571 / 10000 : ℝ) * d * Y ^ (2 : ℕ) * Real.log ((20001 / 10000 : ℝ) / d) ^ (2 : ℕ)) →
  ∀ (x : ℝ),
    (96 : ℝ) * (10 : ℝ) ^ (36 : ℕ) ≤ x →
      ∃ (S : Finset ℕ),
        (∀ n ∈ S,
            x < ↑n ∧
              ↑n < x + (384 : ℝ) * √x * Real.log x ^ (2 : ℕ) ∧
                ∃ (p : ℕ) (q : ℕ),
                  Nat.Prime p ∧ Nat.Prime q ∧ n = p * q ∧ √x / (2 : ℝ) < ↑q ∧ ↑q < √x ∧ √x < ↑p ∧ ↑p < (3 : ℝ) * √x) ∧
          (14 / 3 : ℝ) * √x ≤ ↑S.card ∧ (14 / 9 : ℝ) ≤ ∑ n ∈ S, ↑n.minFac / ↑n
Erdos462RH.composite_sum_384 : (∀ (Y d : ℝ),
    (10 : ℝ) ^ (13 : ℕ) ≤ Y →
      (0 : ℝ) < d →
        d ≤ (1 : ℝ) / (10 : ℝ) ^ (13 : ℕ) →
          ∫ (v : ℝ) in (1 : ℝ)..Y, (Chebyshev.theta (((1 : ℝ) + d) * v) - Chebyshev.theta v - d * v) ^ (2 : ℕ) ≤
            (25571 / 10000 : ℝ) * d * Y ^ (2 : ℕ) * Real.log ((20001 / 10000 : ℝ) / d) ^ (2 : ℕ)) →
  ∀ (x : ℝ),
    (96 : ℝ) * (10 : ℝ) ^ (36 : ℕ) ≤ x →
      (14 / 9 : ℝ) ≤
        ∑ n ∈ Finset.Icc ⌈x⌉₊ ⌊x + (384 : ℝ) * √x * Real.log x ^ (2 : ℕ)⌋₊ with (2 : ℕ) ≤ n ∧ ¬Nat.Prime n,
          ↑n.minFac / ↑n
Erdos462RH.cully_dudek_wide_interval : (∀ (Y d : ℝ),
    (10 : ℝ) ^ (8 : ℕ) ≤ Y →
      (0 : ℝ) < d →
        d ≤ (1 : ℝ) / (10 : ℝ) ^ (8 : ℕ) →
          ∫ (v : ℝ) in (1 : ℝ)..Y, (Chebyshev.theta (((1 : ℝ) + d) * v) - Chebyshev.theta v - d * v) ^ (2 : ℕ) <
            (202 : ℝ) * d * Y ^ (2 : ℕ) * Real.log Y ^ (2 : ℕ)) →
  ∀ (x : ℝ),
    (10 : ℝ) ^ (42 : ℕ) ≤ x →
      ∃ (S : Finset ℕ),
        (∀ n ∈ S,
            x < ↑n ∧
              ↑n < x + (98304 : ℝ) * √x * Real.log x ^ (2 : ℕ) ∧
                ∃ (p : ℕ) (q : ℕ),
                  Nat.Prime p ∧ Nat.Prime q ∧ n = p * q ∧ √x / (2 : ℝ) < ↑q ∧ ↑q < √x ∧ √x < ↑p ∧ ↑p < (3 : ℝ) * √x) ∧
          (1024 : ℝ) * √x ≤ ↑S.card ∧ (1024 / 3 : ℝ) ≤ ∑ n ∈ S, ↑n.minFac / ↑n
Erdos462RH.theorem_1_2_lower : Erdos462RH.CullyDudekBound →
  Erdos462RH.SiebertBound →
    Erdos462RH.PrimeNumberTheorem →
      ∀ (C : ℝ),
        (0 : ℝ) < C →
          ∃ (c : ℝ),
