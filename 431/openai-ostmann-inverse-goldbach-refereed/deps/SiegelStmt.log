OAI.Erdos970.WeightedTorusJets.dirichlet_real_zero_bound : ∃ c,
  0 < c ∧
    ∀ (q : ℕ) [inst : NeZero q],
      3 ≤ q →
        ∀ (χ : DirichletCharacter ℂ q),
          χ.IsPrimitive →
            χ ≠ 1 →
              (∀ (a : ZMod q), (χ a).im = 0) →
                ∀ (β : ℝ), 0 < β ∧ β < 1 ∧ DirichletCharacter.LFunction χ ↑β = 0 → c ≤ (1 - β) * Real.log ↑q
