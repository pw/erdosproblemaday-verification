                    (@LE.le.{0} Real Real.instLE
                      (@Nat.cast.{0} Real Real.instNatCast (OAI.ShortEgyptian.maxMinLength b))
                      (@HMul.hMul.{0, 0, 0} Real Real Real (@instHMul.{0} Real Real.instMul) c₂
                        (Real.log (Real.log (@Nat.cast.{0} Real Real.instNatCast b)))))))))
