                (@OfNat.ofNat.{0} Rat (nat_lit 1) (@Rat.instOfNat (nat_lit 1))) n)
            (@Bind.bind.{0, 0} List.{0} (@Monad.toBind.{0, 0} List.{0} List.instMonad.{0}) Nat Rat ns fun (a : Nat) =>
              @Pure.pure.{0, 0} List.{0}
